<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sentinel.localhost-only-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{SCRIPT_DIR}}/localhost-only-guard.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{HOME}}/.local/share/sentinel-arsenal/logs/localhost-only-guard.out</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/.local/share/sentinel-arsenal/logs/localhost-only-guard.err</string>
</dict>
</plist>
